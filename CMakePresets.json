{
  "version": 6,
  "configurePresets": [{
    "name": "windows", "generator": "Visual Studio 17 2022", "architecture": "x64",
    "binaryDir": "${sourceDir}/build/windows",
    "cacheVariables": {
      "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "VCPKG_TARGET_TRIPLET": "x64-windows-static"
    }
  }],
  "buildPresets": [
    {"name": "release", "configurePreset": "windows", "configuration": "Release"},
    {"name": "debug", "configurePreset": "windows", "configuration": "Debug"}
  ]
}
